# WiFi and team-ticker settings for the Matrix Portal display.
#
# Copy this file to secrets.py on the CIRCUITPY drive and fill in real
# values. secrets.py itself is gitignored — never commit it with real
# credentials in it.

secrets = {
    "ssid": "CHANGE ME",
    "password": "CHANGE ME",
    "ticker_url": "http://lfc-ticker.home/ticker.json",
    # Optional: shows kickoff times converted to local time alongside UTC
    # (e.g. "08-29 11:30 UTC  07:30 EDT"). In minutes, not hours, so
    # fractional-hour timezones (e.g. India UTC+5:30) are exact. No
    # automatic DST - update this by hand when your local offset changes.
    # Omit both (or leave utc_offset_minutes at 0) to show UTC only.
    # "utc_offset_minutes": -240,  # e.g. US Eastern during DST (UTC-4)
    # "timezone_label": "EDT",
}
