# Copy this file to .env and fill in your own team/league.
# Both vars are optional — poller.py falls back to the Liverpool / English
# Premier League reference instance (TEAM_ID=364, LEAGUE=eng.1) if unset.

# ESPN's numeric team id, e.g. 364 for Liverpool FC. Find it by opening
# https://site.api.espn.com/apis/site/v2/sports/soccer/<LEAGUE>/scoreboard
# in a browser and looking at a competitor's "team.id" for your club.
# TEAM_ID=364

# ESPN's league slug, e.g. eng.1 for the English Premier League.
# LEAGUE=eng.1

# UID/GID the container runs as (see docker-compose.yml's `user:` field) —
# should match whichever host user owns the bind-mounted ./data directory,
# so ticker.json comes out owned by you instead of some arbitrary
# container-internal id. Check with `id <your-user>`; both default to 1000
# if unset, which is right on plenty of single-user Linux boxes but not
# guaranteed (e.g. this project's production deploy needs PGID=100).
# PUID=1000
# PGID=1000

# Optional: if you use Uptime Kuma or a compatible push-monitor service,
# set this to the monitor's push URL and every successful cycle pings it
# with status=up (a failed cycle pings status=down instead, before the
# retry/backoff kicks in). Leave unset to skip heartbeat pushes entirely —
# this is a generic tool, not everyone deploying it uses Uptime Kuma.
# KUMA_PUSH_URL=https://uptime.example.com/api/push/xxxxxxxxxx
